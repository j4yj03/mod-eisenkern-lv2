    [ lv2:symbol "saturation"; pset:value 100 ],
    [ lv2:symbol "bass"; pset:value 1 ],
    [ lv2:symbol "remanence"; pset:value 100 ],
    [ lv2:symbol "output"; pset:value 0 ],
    [ lv2:symbol "load"; pset:value 10000 ],
