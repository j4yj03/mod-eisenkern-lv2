    [ lv2:symbol "hf_frequency"; pset:value 26000 ],
    [ lv2:symbol "hf_q"; pset:value 0.70710678118654746 ],
    [ lv2:symbol "family"; pset:value 0 ],
    [ lv2:symbol "exponent"; pset:value 3 ],
    [ lv2:symbol "enabled"; pset:value 1 ],
    [ lv2:symbol "oversampling"; pset:value 0 ] .

